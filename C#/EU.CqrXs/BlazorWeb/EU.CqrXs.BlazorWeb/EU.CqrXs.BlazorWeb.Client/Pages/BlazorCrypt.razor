    </div>
    <hr />
<h3>Great thanks to <a href="https://www.bouncycastle.org/download/bouncy-castle-c/" target="_blank">bouncycastle.org</a>!</h3>

@code {
    private int currentCount = 0;
    public string TextBoxKey_Text { get; set; } = string.Empty;
    public string TextBoxIV_Text { get; set; } = string.Empty;

    private void ImageButtonHash_Click()
    {
        TextBoxIV_Text = $"hash_{TextBoxKey_Text}_{currentCount}";
        currentCount++;
    }

    private void ImageKey_Click()
    {
        TextBoxKey_Text = $"key_{currentCount}";
        currentCount++;
    }


    private void ButtonSetPipe_Click()     
    {
        TextBoxIV_Text = $"setpipe_{TextBoxKey_Text}_{currentCount}";
        currentCount++;
    }


    private void ButtonHashPipe_Click()
    {
        TextBoxIV_Text = $"setpipe_{TextBoxKey_Text}_{currentCount}";
        currentCount++;
    }

    private void ButtonClear_Click()
    {
        TextBoxKey_Text = string.Empty;
        TextBoxIV_Text = string.Empty;
        currentCount++;
    }
}
